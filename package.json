{
  "name": "koishi-plugin-cnb-bot",
  "version": "0.1.2",
  "description": "Koishi plugin for submitting diagnostic logs to CNB Issues and relaying NPC analysis.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarcoChen/cnb-bot-koishi.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepare": "npm run build",
    "pack:check": "node scripts/check-package.cjs"
  },
  "keywords": [
    "koishi",
    "cnb",
    "qq",
    "debug",
    "issue"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "koishi": "^4.18.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "koishi": {
    "description": {
      "zh": "将诊断日志提交到 CNB Issue，并转发 NPC 分析结果。",
      "en": "Submit diagnostic logs to CNB Issues and relay NPC analysis."
    },
    "service": {
      "required": [
        "database"
      ]
    }
  }
}
